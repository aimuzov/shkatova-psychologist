{
	"name": "shkatova-psychologist",
	"type": "module",
	"version": "1.3.2",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"chat": "node --watch --env-file-if-exists=.env --import ./src/backend/instrument.ts src/backend/server.ts",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings"
	},
	"dependencies": {
		"@aimuzov/infra-node-kit": "github:aimuzov/infra-node-kit#52a4c6048915370f2e814fbac690ef7c49025b2e",
		"@sentry/node": "11.9.0"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#b7bcdbe8ade8e06a7bea4f55ff4f29796388241e",
		"@astrojs/check": "0.9.12",
		"@astrojs/sitemap": "3.7.6",
		"@astrojs/svelte": "9.1.6",
		"@fontsource/golos-text": "5.3.0",
		"@fontsource/prata": "5.3.0",
		"@playwright/test": "1.65.1",
		"@sentry/browser": "11.9.0",
		"@types/node": "26.6.6",
		"astro": "7.4.13",
		"oxlint": "1.94.0",
		"prettier": "3.10.1",
		"stylelint": "17.16.0",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*",
		"#package.json": "./package.json"
	}
}
