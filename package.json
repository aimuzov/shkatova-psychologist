{
	"name": "shkatova-psychologist",
	"type": "module",
	"version": "1.3.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"chat": "node --watch --env-file-if-exists=.env --import ./src/backend/instrument.ts src/backend/server.ts",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings"
	},
	"dependencies": {
		"@sentry/node": "11.9.0"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v5.8.1",
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@csstools/postcss-global-data": "4.0.0",
		"@fontsource/golos-text": "5.3.0",
		"@fontsource/prata": "5.3.0",
		"@playwright/test": "1.64.0",
		"@sentry/browser": "11.9.0",
		"@types/node": "26.6.5",
		"astro": "7.3.7",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"stylelint": "17.16.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*",
		"#package.json": "./package.json"
	}
}
